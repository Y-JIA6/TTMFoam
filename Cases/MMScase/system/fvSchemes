FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler; // Implicite, parfait pour ce modèle 
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none; // Pas de convection des fluides, c'est correct
}

laplacianSchemes
{
    // utilisation de "corrected" avec un wedge axisymétrique car les cellules sont légèrement déformées
    default         Gauss linear corrected; 
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    // utilisation de "corrected" avec un wedge axisymétrique
    default         corrected;
}

