FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     TTmTi;
startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         1e-14;
mmsVerification true;


deltaT          1e-17;

writeControl    timeStep;
writeInterval   1000;

purgeWrite      0;

writeFormat     ascii;
writePrecision  8; 
writeCompression off;

timeFormat      scientific;
timePrecision   6;
runTimeModifiable true;

// Time step control (for MMS verification only)
adjustTimeStep  no;
maxDeltaT       1e-14; 



// Ativate probes
libs            ("libsampling.so");

// ************************************************************************* //