FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    Te
    {
        solver          GAMG;
        tolerance       1e-6;   
        relTol          0.01;   
        smoother        GaussSeidel; 
        nPreSweeps      0; 
        nPostSweeps     2;
        cacheAgglomeration true; 
        nCellsInCoarsestLevel 50; 
        agglomerator    faceAreaPair; 
        mergeLevels     1; 
    }

    Tl
    {
        solver          PCG;    
        preconditioner  DIC;    
        tolerance       1e-6;
        relTol          0.01;
    }
}

