FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

// 5-degree wedge sector representing an axisymmetric domain: radius 15 um
// and depth 2 um. The MMS mesh is uniform to isolate spatial convergence.
vertices
(
    (0 0 0)                           // 0: lower axis vertex
    (15e-6 -0.654e-6 0)               // 1: lower front radial vertex
    (15e-6  0.654e-6 0)               // 2: lower back radial vertex
    (0 0 2e-6)                        // 3: upper axis vertex
    (15e-6 -0.654e-6 2e-6)            // 4: upper front radial vertex
    (15e-6  0.654e-6 2e-6)            // 5: upper back radial vertex
);

// 200 radial, 1 azimuthal, and 128 uniform depth cells.
blocks
(
    hex (0 1 2 0 3 4 5 3) (200 1 128) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    axis
    {
        type empty; // Degenerate axis face of the wedge sector.
        faces
        (
            (0 3 3 0)
        );
    }
    right
    {
        type patch; // Boundary condition is specified in the 0/ fields.
        faces
        (
            (1 2 5 4)
        );
    }
    front
    {
        type wedge;
        faces
        (
            (0 1 4 3)
        );
    }
    back
    {
        type wedge;
        faces
        (
            (0 3 5 2)
        );
    }
    bottom
    {
        type patch; // Boundary condition is specified in the 0/ fields.
        faces
        (
            (0 2 1 0)
        );
    }
    top
    {
        type patch; // Upper boundary of the verification domain.
        faces
        (
            (3 4 5 3)
        );
    }
);

