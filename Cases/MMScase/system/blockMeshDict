FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

// Dimensions de l'article : Rayon = 15µm, Profondeur = 2µm
vertices
(
    (0 0 0)                           // 0: Bottom Axis (Z = 0)
    (15e-6 -0.654e-6 0)               // 1: Bottom Right Front
    (15e-6  0.654e-6 0)               // 2: Bottom Right Back
    (0 0 2e-6)                        // 3: Top Axis (Surface Laser à Z = 2µm)
    (15e-6 -0.654e-6 2e-6)            // 4: Top Right Front
    (15e-6  0.654e-6 2e-6)            // 5: Top Right Back
);

// Maillage : 200 mailles en radial, 1 en azimutal, 600 en profondeur
blocks
(
    hex (0 1 2 0 3 4 5 3) (200 1 128) simpleGrading (1 1 1) 
);

edges
(
);

boundary
(
    axis
    {
        type empty; // L'axe ne résout rien
        faces
        (
            (0 3 3 0)
        );
    }
    right
    {
        type patch; // On appliquera un zeroGradient dans 0/
        faces
        (
            (1 2 5 4)
        );
    }
    front
    {
        type wedge;
        faces
        (
            (0 1 4 3)
        );
    }
    back
    {
        type wedge;
        faces
        (
            (0 3 5 2)
        );
    }
    bottom
    {
        type patch; // On appliquera un zeroGradient dans 0/
        faces
        (
            (0 2 1 0)
        );
    }
    top
    {
        type patch; // Surface chauffée par le laser
        faces
        (
            (3 4 5 3)
        );
    }
);

