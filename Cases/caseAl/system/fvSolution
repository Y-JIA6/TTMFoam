FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Solve the inner linear systems to convergence so that the outer Picard
    // criterion measures nonlinear-property updates rather than linear error.
    Te
    {
        solver          GAMG;
        tolerance       1e-8;   // Absolute linear-solver tolerance.
        relTol          0;      // Do not stop on a relative-residual reduction.
        smoother        GaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration true; // Reuse agglomeration because the mesh is static.
        nCellsInCoarsestLevel 50;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    Tl
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;      // Do not stop on a relative-residual reduction.
    }
}

