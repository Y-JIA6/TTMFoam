FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler; // Implicit first-order time integration.
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none; // The TTM equations contain no convective fluxes.
}

laplacianSchemes
{
    // Correct the normal gradient for the non-orthogonality of the wedge mesh.
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    // Use the same non-orthogonality correction for surface-normal gradients.
    default         corrected;
}

