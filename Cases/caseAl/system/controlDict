FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     TTmAl;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         20e-12;         // 20 ps, long enough for the lattice to equilibrate

deltaT          1e-15;          // 1 fs; the electron relaxation time is about 0.4 fs

writeControl    adjustableRunTime;
writeInterval   1e-13;          // one write every 0.1 ps
purgeWrite      0;

writeFormat     ascii;
writePrecision  8;              // 8 digits to resolve the very high electron temperatures
writeCompression off;

timeFormat      scientific;     // keeps the very short times from rounding down to 0
timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;             // fixed stepping, the solver drives dt itself
maxDeltaT       1e-14;          // 10 fs ceiling, keeps the solver stable after the pulse

libs            ("libsampling.so");     // required by the probes function object

// Picard outer loop, bounds on the non-linear electron-lattice coupling

picardMaxIter   15;
picardAbsTol    0.001;
picardRelTol    1e-06;
// ************************************************************************* //
