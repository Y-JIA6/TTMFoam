FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      ttmProperties;
}
// ===========================================================================
//  ttmProperties
//  Material parameters for the aluminum two-temperature-model case.
//  SI units are used throughout unless explicitly stated otherwise.
// ===========================================================================

// ---------------------------------------------------------------------------
// 0. Ambient state and reference values
// ---------------------------------------------------------------------------
T0              [0 0 0 1 0 0 0] 300.0;

// Reference electron--phonon coupling coefficient G(300 K) [W/(m3.K)].
G               [1 -1 -3 -1 0 0 0] 2.5e17;

// Initial values overwritten during the first Picard iteration.
Ce              [1 -1 -2 -1 0 0 0] 2.3e4;   // FEG value near 300 K [J/(m3.K)].
Cl              [1 -1 -2 -1 0 0 0] 2.4e6;   // Shomate value near 300 K [J/(m3.K)].
ke              [1 1 -3 -1 0 0 0] 178.0;    // Kinetic-theory value near 300 K [W/(m.K)].
kl              [1 1 -3 -1 0 0 0] 1.8;      // ke/99 near 300 K [W/(m.K)].

// ---------------------------------------------------------------------------
// 1. Free-electron-gas thermodynamics
// ---------------------------------------------------------------------------

gamma           [1 -1 -2 -2 0 0 0]        76.7;  // Sommerfeld coefficient [J/(m3.K2)].

// Aluminum Fermi energy read as EF by createTables.H [J].
mu              [1 2 -2 0 0 0 0] 1.87454666e-18;   // EF = 11.7 eV

// ---------------------------------------------------------------------------
// 2. Electron relaxation and transport
// ---------------------------------------------------------------------------

// Electron--electron collision coefficient Ae [1/(s.K2)].
Ae              [0 0 -1 -2 0 0 0]    0.376e7;

// Electron--phonon collision coefficient Bl [1/(s.K)].
Bl              [0 0 -1 -1 0 0 0]  5.92e11;

// Fermi velocity vF [m/s].
vF              [0 1 -1 0 0 0 0] 2.03e6;

// ---------------------------------------------------------------------------
// 3. Lattice thermodynamics
// ---------------------------------------------------------------------------

// Dimensionless NIST coefficients for solid aluminum: 298.15 K to 933.47 K.
ShA_sol         [0 0 0 0 0 0 0] 28.089;
ShB_sol         [0 0 0 0 0 0 0] -5.415;
ShC_sol         [0 0 0 0 0 0 0] 8.560;
ShD_sol         [0 0 0 0 0 0 0] 3.427;
ShE_sol         [0 0 0 0 0 0 0] -0.277;

// Dimensionless NIST coefficients for liquid aluminum: 933.47 K to 6000 K.
ShA_liq         [0 0 0 0 0 0 0] 31.751;
ShB_liq         [0 0 0 0 0 0 0] 0.0;
ShC_liq         [0 0 0 0 0 0 0] 0.0;
ShD_liq         [0 0 0 0 0 0 0] 0.0;
ShE_liq         [0 0 0 0 0 0 0] 0.0;

// Conversion factor from [J/(mol.K)] to [J/(m3.K)].
// Value = (rho / M) = 2700 / 0.02698 = 100074.1.
Cl_mult         [1 -1 -2 -1 0 0 0] 100074.1;
